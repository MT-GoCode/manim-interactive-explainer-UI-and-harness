{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explainer/index",
  "title": "build/index.json \u2014 written by explain-build, read by the app",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "lesson_sha",
    "inputs",
    "repo_root",
    "manim_version",
    "fps",
    "refs",
    "cells"
  ],
  "properties": {
    "format": {
      "const": "explainer"
    },
    "version": {
      "const": 1
    },
    "lesson_sha": {
      "$ref": "#/$defs/sha"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle",
        "repo"
      ],
      "properties": {
        "bundle": {
          "$ref": "#/$defs/files"
        },
        "repo": {
          "$ref": "#/$defs/files"
        }
      }
    },
    "repo_root": {
      "type": "string",
      "pattern": "^/",
      "description": "absolute path of the explainers checkout that built it; inputs.repo paths are relative to it"
    },
    "manim_version": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "clip",
          "frames_sha",
          "frames",
          "fingerprint"
        ],
        "properties": {
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "clip": {
            "type": "string",
            "pattern": "^clips/[0-9a-f]{64}\\.mp4$"
          },
          "frames_sha": {
            "$ref": "#/$defs/sha"
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          },
          "fingerprint": {
            "$ref": "#/$defs/sha",
            "description": "what the cell's frames draw and everything after them that shapes its clip; equal fingerprints, equal clips"
          }
        }
      }
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha"
      }
    }
  }
}
