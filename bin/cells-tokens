#!/usr/bin/env -S uv run -q --script
# /// script
# dependencies = ["tokenizers"]
# ///
# cells-tokens <max tokens> <bundle or cells.md>...: print each "## slug" cell over <max tokens> (DeepSeek-V4 tokenizer).
import re, sys
from tokenizers import Tokenizer

tok, (limit, *paths) = Tokenizer.from_pretrained("deepseek-ai/DeepSeek-V4-Pro"), sys.argv[1:]
over = [f"{f} ## {slug}: {n} tokens" for f in (p if p.endswith(".md") else f"{p}/cells.md" for p in paths)
        for slug, body in re.findall(r"^## (\S+)\n(.*?)(?=^## |\Z)", open(f).read(), re.M | re.S)
        if (n := len(tok.encode(body).ids)) > int(limit)]
print(*over, sep="\n") if over else None
sys.exit(1 if over else 0)
